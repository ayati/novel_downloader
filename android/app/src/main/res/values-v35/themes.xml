<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15 (API 35) 以降は targetSdk 35 のアプリに対してエッジツーエッジ表示が
  強制される。本アプリは AppCompat の ActionBar をそのまま使っており
  ウィンドウインセットを処理していないため、本文がステータスバーと ActionBar の
  裏に潜り込む（実機で確認: Android 16 では URL 入力欄と［貼り付け／クリア］行が
  ActionBar の上にはみ出して操作できない。Android 13 では発生しない）。

  ここでは公式の移行用フラグで強制を解除し、Android 13 と同じ挙動に揃える。
  これは過渡期向けの属性で将来の SDK で削除されるため、恒久対応としては
  Toolbar + enableEdgeToEdge() + インセット処理への移行が必要
  （android/design_history.md / design_i18n.md とは別件の将来課題）。
-->
<resources>
    <style name="Theme.NovelDownloader" parent="Theme.Material3.DayNight">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
